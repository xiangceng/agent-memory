# 统一换行符，避免 Windows/Linux 混用产生大量无意义 diff
* text=auto

# 源码与文档用 LF
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.pdf   binary
*.png   binary
*.jpg   binary
*.xlsx  binary
*.docx  binary
