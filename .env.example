# 复制本文件为 .env 后填入真实值
# 注意：.env 已在 .gitignore 中，不会被提交

# ---------- 生成模型（reader）----------
# 选一个即可，国产模型便宜很多
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 备选：通义
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus

# ---------- 判分模型（judge）----------
# LongMemEval 官方 evaluate_qa.py 默认用 gpt-4o 判分。
# 若用 OpenAI 兼容端点，需在脚本里改 base_url，或单独开一个 OpenAI key。
# 建议：判分模型固定不变（换判分模型后历史结果不可比！）
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_API_KEY=sk-xxxxxxxxxxxxxxxx
JUDGE_MODEL=deepseek-chat

# ---------- Embedding（本地）----------
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu          # 有 GPU 改成 cuda

# ---------- 实验预算控制 ----------
# 每次实验的模型调用上限（用于"同预算对比"）
MAX_LLM_CALLS_PER_QUESTION=10
# 先跑子集验证流程，再放开全量
SUBSET_SIZE=50
